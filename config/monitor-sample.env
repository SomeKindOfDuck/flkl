# bash src/flkl/monitor/daily.sh --manual で手動実行する際の環境設定
# このファイルを config/monitor.env にコピーし、環境に合わせて書き換える。
# (config/monitor.env は .gitignore の対象。bash から source されるので、bash の書式で記述する)

# tdms が保存されている NAS の SMB 共有。gio mount でマウントする
NAS_URI="smb://fnas.local/fnas_local/"

# マウント後の行動データのディレクトリ(GNOME の GVFS のマウント先)。この下の tdms/ に tdms、parquet/ に binary parquet を置く
# (NAS_TDMS_DIR、NAS_PARQUET_DIR で別の場所にもできる)
NAS_DIR="/run/user/$(id -u)/gvfs/smb-share:server=fnas.local,share=fnas_local/Yamada_data/bhv"

# detect(tdms-viewer)のパラメータ設定ファイル。相対パスはプロジェクトのルートから
DETECT_CONFIG="default.yaml"

# 1 にすると、2p のデータがある日(data/2p/{subject}-{date}/)の binary parquet を data/behavior/ にコピーする(既定 0: しない)
SYNC_2P_BEHAVIOR=0
